# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=osaware_db
PG_USER=postgres
PG_PASSWORD=postgres

# Optional tuning (defaults shown)
# HIGH_LOAD_EXTERNAL_CPU=45   # external CPU % at which load counts as "high"
# MIN_SAMPLES=3               # runs of each plan before deciding
# WIN_MARGIN=0.10             # serial must be >=10% faster...
# DOMINANCE=0.75              # ...and faster in >=75% of run pairs
# REJECT_RATIO=1.5            # stop trying serial if 1.5x slower
# RECHECK_EVERY=25            # re-measure the other plan every N runs
