# Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=osaware_db
PG_USER=postgres
PG_PASSWORD=postgres

# Middleware Mode
# Set to true if PostgreSQL is not installed/running yet so you can test end-to-end
USE_MOCK_DB=false

# Telemetry Configuration
TELEMETRY_SAMPLE_INTERVAL_SEC=0.5
CPU_STRESS_THRESHOLD=75.0
MEMORY_STRESS_THRESHOLD=80.0

# Logging & Storage
SQLITE_FEEDBACK_DB=logs/feedback.db
MODEL_PATH=models/os_aware_model.pkl
