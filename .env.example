# PostgreSQL connection (the bundled server: python main.py db-start)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=tpch
PG_USER=postgres
PG_PASSWORD=postgres

# Optional tuning
# HIGH_LOAD_EXTERNAL_CPU=45     # external CPU % at which load counts as "high"
# MIN_PREDICTED_GAIN=0.15       # AI uses a non-default plan only if it predicts >= 15% gain
# ENSEMBLE_SIZE=5               # number of models in the ensemble (uncertainty estimate)
# SHORT_QUERY_MS=100            # queries predicted shorter than this skip the plan search

# OS layer
# OS_BOOST=auto                 # auto = HIGH process priority for PostgreSQL under high external load; on | off
# MEMORY_BUDGET_MB=1024         # scheduler: max total working-memory claims of running queries (Banker's check)
